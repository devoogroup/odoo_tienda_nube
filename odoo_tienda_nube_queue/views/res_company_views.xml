<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_tn_queue" model="ir.ui.view">
        <field name="name">res.company.form.tn.queue</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="odoo_tienda_nube.view_company_form_tn"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='TN']//group[1]/group[1]" position="after">
                <group string="Cola de Sincronización">
                    <field name="tn_queue_enabled"/>
                    <field name="tn_queue_batch_size" invisible="not tn_queue_enabled"/>
                    <field name="tn_queue_max_retries" invisible="not tn_queue_enabled"/>
                    <field name="tn_queue_retention_days" invisible="not tn_queue_enabled"/>
                    <field name="tn_last_fetch_datetime" readonly="1" invisible="not tn_queue_enabled"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
