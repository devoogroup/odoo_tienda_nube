<odoo>
    <data>

    <record id="rule_category_tn_company" model="ir.rule">
        <field name="name">Categoria Tienda Nube - Multiempresa</field>
        <field name="model_id" ref="model_category_tn"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_coupon_tn_company" model="ir.rule">
        <field name="name">Cupon Tienda Nube - Multiempresa</field>
        <field name="model_id" ref="model_coupon_tn"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>
    
    <record id="rule_webhook_tn_company" model="ir.rule">
        <field name="name">Webhook Tienda Nube - Multiempresa</field>
        <field name="model_id" ref="model_webhook_tn"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>

    </data>
</odoo>