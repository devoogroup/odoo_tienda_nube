<odoo>
    <data>
    
        <record id="view_create_all_category_wizard_form" model="ir.ui.view">
            <field name="name">create.all.category.wizard.form</field>
            <field name="model">create.all.category.wizard</field>
            <field name="arch" type="xml">
                <form string="Create All Category Wizard">
                        <h3>Creará todos las categorias de Tienda Nube que no estén en Odoo, la forma de comparar si existen o no es por medio del ID de Tienda Nube</h3>
                    <footer>
                        <button name="create_all_category" confirm="¿Seguro que quiere traer las categorias a Odoo?" string="Crear categorias en Odoo" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>