<odoo>
    <data>
    
        <record id="view_create_all_products_wizard_form" model="ir.ui.view">
            <field name="name">create.all.products.wizard.form</field>
            <field name="model">create.all.products.wizard</field>
            <field name="arch" type="xml">
                <form string="Create All Products Wizard">
                        <h3>Creará todos los productos de Tienda Nube que no estén en Odoo, la forma de comparar si existen o no es por medio del ID de Tienda Nube</h3>
                    <footer>
                        <button name="create_all_products" confirm="¿Seguro que quiere traer los productos a Odoo?" string="Crear productos en Odoo" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>