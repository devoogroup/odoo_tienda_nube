<odoo>
    <data>
    
        <record id="view_create_all_webhook_wizard_form" model="ir.ui.view">
            <field name="name">create.all.webhook.wizard.form</field>
            <field name="model">create.all.webhook.wizard</field>
            <field name="arch" type="xml">
                <form string="Create All Webhook Wizard">
                        <h3>Creará todos los webhook de Tienda Nube que no estén en Odoo, la forma de comparar si existen o no es por medio del ID de Tienda Nube</h3>
                    <footer>
                        <button name="create_all_webhook" confirm="¿Seguro que quiere traer los webhook a Odoo?" string="Crear webhook en Odoo" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>