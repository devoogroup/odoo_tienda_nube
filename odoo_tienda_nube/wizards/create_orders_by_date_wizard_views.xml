<odoo>
    <data>

        <record id="view_create_orders_by_date_wizard_form" model="ir.ui.view">
            <field name="name">create.orders.by.date.wizard.form</field>
            <field name="model">create.orders.by.date.wizard</field>
            <field name="arch" type="xml">
                <form string="Importar Órdenes por Fecha">
                    <group>
                        <h3>Traerá las órdenes de Tienda Nube dentro del rango de fechas indicado. Las órdenes que ya existan en Odoo (por ID de Tienda Nube) no serán duplicadas.</h3>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <footer>
                        <button name="create_orders_by_date" confirm="¿Seguro que quiere importar las órdenes del rango de fechas seleccionado?" string="Importar Órdenes" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
