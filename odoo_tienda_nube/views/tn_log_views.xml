<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tn_log_tree" model="ir.ui.view">
        <field name="name">view.tn.log.tree</field>
        <field name="model">tn.log</field>
        <field name="arch" type="xml">
            <list decoration-success="level == 'success'"
                decoration-info="level == 'info'"
              	decoration-warning="level == 'warning'"
              	decoration-danger="level == 'error'">
                <field name="name" readonly="1"/>
                <field name="date" readonly="1"/>
                <field name="message" readonly="1"/>
                <field name="level" readonly="1"/>
                <field name="model" readonly="1"/>
            </list>
        </field>
    </record>
    
    <record id="view_tn_log_form" model="ir.ui.view">
        <field name="name">view.tn.log.form</field>
        <field name="model">tn.log</field>
        <field name="arch" type="xml">
            <form string="Tn Log">
                <header>
                    <button name="mark_as_solved" string="Marcar como Solucionado" type="object" class="oe_highlight" invisible="level == 'success'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="level" readonly="1"/>
                        </group>
                        <group>
                            <field name="model" readonly="1"/>
                            <field name="model_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" readonly="1"/>
                        <field name="error_tn" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_tn_log_search" model="ir.ui.view">
        <field name="name">view.tn.log.search</field>
        <field name="model">tn.log</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Nombre" name="name" domain="[]" context="{'group_by':'name'}"/>
                    <filter string="Tipo" name="level" domain="[]" context="{'group_by':'level'}"/>
                    <filter string="Modelo" name="model" domain="[]" context="{'group_by':'model'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
