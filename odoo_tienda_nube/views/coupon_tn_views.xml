<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_coupon_tn_tree" model="ir.ui.view">
        <field name="name">view.coupon.tn.tree</field>
        <field name="model">coupon.tn</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="used" readonly="1"/>
                <field name="type_tn"/>
                <field name="value"/>
                <field name="min_price"/>
                <field name="categoria_tn_ids"/>
                <field name="valid"/>
                <field name="id_tn"/>
            </list>
        </field>
    </record>
    
    <record id="view_coupon_tn_form" model="ir.ui.view">
        <field name="name">view.coupon.tn.form</field>
        <field name="model">coupon.tn</field>
        <field name="arch" type="xml">
            <form string="Coupon Tn">
                <header>
                    <button name="create_coupon_tn" string="Crear en Tienda Nube" type="object" class="oe_highlight" invisible="id_tn != False" />
                    <button name="write_coupon_tn" string="Editar en Tienda Nube" type="object" class="oe_highlight" invisible="id_tn == False" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="DESC-ODOO"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="id_tn" readonly="1"/>
                            <field name="type_tn"/>
                            <field name="value"/>
                            <field name="valid"/>
                            <field name="max_use"/>
                            <field name="used" readonly="1"/>
                        </group>
                        <group>
                            <field name="includes_shipping"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="min_price"/>
                            <field name="categoria_tn_ids" domain="[('tn_id', '!=', False)]" options="{'no_create': True, 'no_create_edit':True}" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_coupon_tn_search" model="ir.ui.view">
        <field name="name">view.coupon.tn.search</field>
        <field name="model">coupon.tn</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Tipo" name="group_by_type_tn" domain="[]" context="{'group_by':'type_tn'}"/>
            </search>
        </field>
    </record>

</odoo>
