<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_tn" model="ir.ui.view">
        <field name="name">Datos de la compañía para Tienda Nube</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="TN" string="Tienda Nube">
                    <group>
                        <group>
                            <field name="tiendanube_id" />
                            <field name="tiendanube_access_token" />
                            <field name="tn_confirmation_mode"/>
                            <field name="tn_config_stock"/>
                            <field name="tn_config_stock_realtime"/>
                            <field name="tn_pricelist_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="tn_config_update_product_price_cron"/>
                            <field name="tn_type_tax"/>
                        </group>
                        <group>
                        </group>
                    </group>

                    <separator string="Configuración específica de sincronización de productos" colspan="2"/>
                    <group>
                        <group>
                            <field name="update_product_tn_name" />
                            <field name="update_product_tn_categories" />
                            <field name="update_product_tn_promotional_price" />
                            <field name="update_product_tn_dimensions" />
                            <field name="update_product_tn_sku" />
                            <field name="update_product_tn_mpn" />
                        </group>
                        <group>
                            <field name="update_product_tn_age_group" />
                            <field name="update_product_tn_gender" />
                            <field name="update_product_tn_cost" />
                            <field name="update_product_tn_description" />
                            <field name="update_product_tn_published" />
                            <field name="update_product_tn_free_shipping" />
                        </group>
                    </group>

                </page>
            </xpath>
        </field>
    </record>
</odoo>