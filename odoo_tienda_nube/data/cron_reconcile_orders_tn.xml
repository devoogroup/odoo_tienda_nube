<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Reconciliar ordenes del dia anterior: red de seguridad ante fallos de webhooks -->
        <record id="ir_cron_reconcile_orders_tn" model="ir.cron">
            <field name="name">Tienda Nube: Reconciliar Ordenes del Dia Anterior</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="state">code</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="code"><![CDATA[
companies = model.search([
    ('tiendanube_access_token', '!=', False),
    ('tiendanube_id', '!=', False),
])
for company in companies:
    company.with_company(company).reconcile_daily_orders_tn()
]]></field>
        </record>

    </data>
</odoo>
