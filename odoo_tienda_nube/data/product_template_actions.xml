<odoo>
    <record id="server_action_create_tn" model="ir.actions.server">
        <field name="name">Crear en Tienda Nube</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
        for record in records:
        record.create_tn()
        ]]></field>
    </record>

    <record id="server_action_update_price_tn" model="ir.actions.server">
        <field name="name">Actualizar precio en Tienda Nube</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
        env.company.update_product_price_tn(records)
        ]]></field>
    </record>

    <record id="server_action_update_product_image_tn" model="ir.actions.server">
        <field name="name">Actualizar imagen en Tienda Nube</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
        for record in records:
        record.update_product_image_tn()
        ]]></field>
    </record>

    <record id="server_action_update_tn" model="ir.actions.server">
        <field name="name">Actualizar en Tienda Nube</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
        for record in records:
        record.update_tn()
        ]]></field>
    </record>
</odoo>
